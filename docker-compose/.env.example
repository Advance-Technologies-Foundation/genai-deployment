################################################################################
# REQUIRED - Set your API key
################################################################################

OPENAI_API_KEY=

# AZURE_API_KEY=
# AZURE_API_BASE=https://your-resource.openai.azure.com

################################################################################
# AUTO-GENERATED - Generate random values using: openssl rand -base64 32
################################################################################

POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
PROXY_MASTER_KEY=CHANGE_ME_PROXY_MASTER_KEY
CREATIO_LICENSE_KEY=


################################################################################
# OPTIONAL - Defaults work for most cases
################################################################################

TAG=2.0.232

INTERNAL_DOMAIN=tscrm.com
ENRICHMENT_PORT=5006

POSTGRES_USER=postgres
POSTGRES_HOST=enrichment-postgres
POSTGRES_DB=enrichment
POSTGRES_SEARCHPATH=enrichment
POSTGRES_PORT=5432

REDIS_ENABLED=true
REDIS_HOST=enrichment-redis
REDIS_PORT=6379

OPENAI_MODEL=gpt-5.2
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

AZURE_MODEL=azure/gpt-5.2
AZURE_EMBEDDING_MODEL=azure/text-embedding-3-large
AZURE_API_VERSION=2024-10-21
AZURE_EMBEDDING_API_BASE=${AZURE_API_BASE}
AZURE_DEPLOYMENTID=
AZURE_RESOURCENAME=

GenAI__ProviderType=-1
GenAI__OpenAIApiKey=${PROXY_MASTER_KEY}
GenAI__DefaultModel=azure-model
GenAI__EmbeddingsModel=text-embedding-3-large

LITELLM_LOG=ERROR
LOG_LEVEL=ERROR
TRACE_DEBUG_INFO=false

MIN_THREADS=1000

MAX_REQUESTS_PER_HOUR=-1
MAX_REQUESTS_PER_DAY=-1
MAX_REQUESTS_PER_MONTH=-1
MAX_TOKENS_PER_HOUR=-1
MAX_TOKENS_PER_DAY=-1
MAX_TOKENS_PER_MONTH=-1
MAX_TOKENS_PER_MINUTE=-1
MAX_TOTAL_TOKENS=-1
